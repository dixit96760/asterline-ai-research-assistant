# .env.example
# ===========================================================================
# Asterline AI Research Assistant Configuration
# Copy this file to .env and configure appropriate values
# ===========================================================================

# LLM Provider Configuration
# Supported providers: "openai" (uses OpenAI or OpenAI-compatible endpoint), or "offline" (deterministic evidence synthesis)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
# Optional base URL for OpenAI-compatible proxies / local models:
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30.0

# Memory Database
# Path to SQLite database file for user notes and memories (relative to project root or absolute)
MEMORY_DB_PATH=data/memory.db

# Observability and Tracing (Optional)
# Set to 'true' and supply an API key to enable LangSmith tracing
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline-assistant
# LANGCHAIN_TRACING_V2 is also supported and automatically set when tracing is active
